fn option_text(item: Option[Text]) -> Text {
    match item { Option::Some(text) => { text }, Option::None => { "none" } }
}
fn option_int(item: Option[Int]) -> Text {
    match item { Option::Some(number) => { int_text(number) }, Option::None => { "none" } }
}

pub fn main() -> List[Text] {
    let format = int_text;
    let mapped: fn(List[Int], fn(Int) -> Text) -> List[Text] = map;
    let total = fold([1, 2, 3], 0, fn(acc: Int, x: Int) -> Int { acc * 10 + x });
    let empty = fold([], 7, fn(acc: Int, x: Int) -> Int { acc div x });
    let unicode = "a\u{1F642}\u{0}b";
    mapped(append(range(-2, 1), 3), format) ++ [
        int_text(total), int_text(empty), int_text(len(range(3, -3))),
        option_int(at([7, 8], 1)), option_int(at([7], -1)),
        option_int(parse_int("-9223372036854775808")), option_int(parse_int("01")),
        option_int(parse_int("12\u{0}")), option_int(float_int(int_float(9223372036854775807))),
        option_int(float_int(-2.75)), float_text(0.1), float_text(5e-324),
        int_text(text_len(unicode)), option_text(text_at(unicode, 1)),
        option_text(text_slice(unicode, 2, 4)), option_text(text_slice(unicode, 4, 4)),
        option_text(text_slice(unicode, 5, 5)), bool_text(false)
    ]
}
