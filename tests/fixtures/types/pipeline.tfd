machine Sample(request: Unit) yields Bool rejects Text {
    state baseline: Bool = -7 div 2 == -4;
    next baseline = baseline;
    emit next.baseline;
}

fn choose(value: Option[Bool]) -> Bool {
    match value { Option::Some(selected) => { selected }, Option::None => { false } }
}

fn choose_many(value: Option[Bool]) -> Int {
    let collected = append(match value {
        Option::Some(captured) => {
            let item = if captured { 1 } else { 2 };
            [item]
        },
        Option::None => { [] }
    }, 3);
    len(collected)
}
