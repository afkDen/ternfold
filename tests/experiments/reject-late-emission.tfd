machine Early(delta: Int) yields Text rejects Text {
    state n: Int = 0;
    next n = delta;
    guard false else "reject";
}
machine Late(delta: Int) yields Text rejects Text {
    state n: Int = 0;
    next n = delta;
    emit "private";
    emit int_text(1 div delta);
}
pub fn main() -> List[Text] {
    output "staged";
    let early = step(Early(), 0);
    let late = step(Late(), 0);
    match early {
        Decision::Reject(s, reason) => { [reason] },
        Decision::Accept(s, events) => { events }
    }
}
